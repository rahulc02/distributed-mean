{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RahulVC02/distributed-mean/contracts/messages.schema.json",
  "title": "distributed-mean queue messages, version 1",
  "$defs": {
    "OperandRef": {
      "type": "object",
      "required": ["id", "key", "count"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "f{i} for input files, the producing task id for partials" },
        "key": { "type": "string", "description": "object storage key" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "TaskMessage": {
      "description": "Coordinator to workers, on the 'tasks' queue.",
      "type": "object",
      "required": ["v", "job_id", "task_id", "level", "final", "f", "c", "inputs", "output_key"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "job_id": { "type": "string", "format": "uuid" },
        "task_id": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "final": { "type": "boolean", "description": "input counts sum to f; write the result CSV" },
        "f": { "type": "integer", "minimum": 2 },
        "c": { "type": "integer", "minimum": 2 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/OperandRef" } },
        "output_key": { "type": "string", "description": "chosen by the coordinator; workers never build keys" }
      }
    },
    "CompletionMessage": {
      "description": "Workers to coordinator, on the 'completions' queue.",
      "type": "object",
      "required": ["v", "job_id", "task_id", "output_key", "count", "duration_ms", "worker_id"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "job_id": { "type": "string", "format": "uuid" },
        "task_id": { "type": "string" },
        "output_key": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "worker_id": { "type": "string" }
      }
    }
  }
}
