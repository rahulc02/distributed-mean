POSTGRES_PASSWORD=dmean
POSTGRES_DB=dmean
RABBITMQ_DEFAULT_USER=dmean
RABBITMQ_DEFAULT_PASS=dmean

# Fan-in per task. 5 matches the assignment's "5 files at a time"; both are tunable.
K_LEAF=5
K_MERGE=5
