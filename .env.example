# Copy to .env and adjust. Every service reads its settings from the environment.
POSTGRES_USER=dmean
POSTGRES_PASSWORD=dmean
POSTGRES_DB=dmean
RABBITMQ_DEFAULT_USER=dmean
RABBITMQ_DEFAULT_PASS=dmean

# Ports published on the host. Change them if something else already listens there.
POSTGRES_HOST_PORT=5432
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# Fan-in per task. 5 matches the assignment's "5 files at a time"; both are tunable.
K_LEAF=5
K_MERGE=5

# How long a draining worker may finish its task before it is killed; also Compose's stop grace period.
DRAIN_GRACE_S=120
# RabbitMQ closes the channel of a consumer holding a task longer than this, and redelivers the task.
RABBITMQ_CONSUMER_TIMEOUT_MS=600000
